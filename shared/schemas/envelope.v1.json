{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-monitor.local/schemas/envelope.v1.json",
  "title": "Common message envelope (edge -> server)",
  "type": "object",
  "required": ["schema", "msg_id", "collector_id", "ts", "seq", "data"],
  "properties": {
    "schema": { "type": "string" },
    "msg_id": {
      "description": "UUIDv7, idempotency key on the server",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "collector_id": { "$ref": "#/$defs/identifier" },
    "machine_id": { "$ref": "#/$defs/identifier" },
    "ts": {
      "description": "Time the value was read on the edge, UTC",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "seq": {
      "description": "Monotonic per-source counter; a gap means lost data",
      "type": "integer",
      "minimum": 0
    },
    "data": { "type": "object" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    }
  }
}
