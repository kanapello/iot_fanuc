# Copy to .env (`make up` does it automatically on the first run) and change the passwords.

# PostgreSQL / TimescaleDB
MM_DB_NAME=mm
MM_DB_USER=mm
MM_DB_PASSWORD=change-me-db

# MQTT accounts (created in the broker on start)
MM_MQTT_BACKEND_USER=backend
MM_MQTT_BACKEND_PASSWORD=change-me-backend
# Simulated collectors of `make up` (profile dev): accounts edge-sim-a (demo/plant1), edge-sim-b (demo/plant2)
MM_MQTT_SIM_A_PASSWORD=change-me-sim-a
MM_MQTT_SIM_B_PASSWORD=change-me-sim-b
# Real collectors, one account each: <collector_id>:<org_code>:<site_code>:<password>[,...]
# A collector may publish only to the topics of its own site. Register it in the admin UI as well.
MM_MQTT_COLLECTORS=

# Web UI / API
MM_WEB_PORT=8080
MM_SECRET_KEY=change-me-long-random-string-at-least-32-chars
# Superadmin account, created on the first start of the API
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=admin
# Development only: demo users (password MM_DEMO_PASSWORD) and demo kiosk tokens. Set false in production.
MM_DEMO_DATA=true
MM_DEMO_PASSWORD=demo

MM_LOG_LEVEL=INFO
