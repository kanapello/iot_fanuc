# Copy to .env (`make up` does it automatically on the first run) and change the passwords.
# Production: `make env-prod domain=... email=...` creates .env with random passwords (ADR 0010).

# dev | prod. In prod the server refuses to start with the change-me values of this file.
MM_ENV=dev

# PostgreSQL / TimescaleDB
MM_DB_NAME=mm
MM_DB_USER=mm
MM_DB_PASSWORD=change-me-db

# MQTT accounts (created in the broker on start)
MM_MQTT_BACKEND_USER=backend
MM_MQTT_BACKEND_PASSWORD=change-me-backend
# Simulated collectors of `make up` (profile dev): accounts edge-sim-a (demo/plant1), edge-sim-b (demo/plant2)
MM_MQTT_SIM_A_PASSWORD=change-me-sim-a
MM_MQTT_SIM_B_PASSWORD=change-me-sim-b
# Real collectors, one account each: <collector_id>:<org_code>:<site_code>:<password>[,...]
# A collector may publish only to the topics of its own site. Register it in the admin UI as well.
MM_MQTT_COLLECTORS=

# Web UI / API
MM_WEB_PORT=8080
# Production (make prod-up): the DNS name of the server and an email for Let's Encrypt notices.
# MM_PUBLIC_URL is then https://MM_DOMAIN.
MM_DOMAIN=
MM_ACME_EMAIL=
# Address of the web UI as people open it, e.g. https://mm.example.com: printed in the QR codes of machine
# stickers. Empty = the address the administrator opened the UI by (fine without an outer HTTPS proxy).
MM_PUBLIC_URL=
MM_SECRET_KEY=change-me-long-random-string-at-least-32-chars
# Superadmin account, created on the first start of the API
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=admin
# Development only: demo users (password MM_DEMO_PASSWORD) and demo kiosk tokens. Set false in production.
MM_DEMO_DATA=true
MM_DEMO_PASSWORD=demo

MM_LOG_LEVEL=INFO

# Backups (production): nightly pg_dump to S3-compatible storage, kept 30 days. The bucket must exist.
MM_BACKUP_S3_ENDPOINT=
MM_BACKUP_S3_REGION=
MM_BACKUP_S3_BUCKET=
MM_BACKUP_S3_ACCESS_KEY=
MM_BACKUP_S3_SECRET_KEY=
MM_BACKUP_S3_PREFIX=machine-monitor
# HH:MM UTC (23:30 UTC = 02:30 Moscow time)
MM_BACKUP_TIME=23:30
MM_BACKUP_KEEP_DAYS=30
