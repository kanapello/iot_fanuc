# Copy to .env (`make up` does it automatically on the first run) and change the passwords.

# PostgreSQL / TimescaleDB
MM_DB_NAME=mm
MM_DB_USER=mm
MM_DB_PASSWORD=change-me-db

# MQTT accounts (created in the broker on start)
MM_MQTT_BACKEND_USER=backend
MM_MQTT_BACKEND_PASSWORD=change-me-backend
MM_MQTT_EDGE_USER=edge
MM_MQTT_EDGE_PASSWORD=change-me-edge

# Web UI / API
MM_WEB_PORT=8080
MM_SECRET_KEY=change-me-long-random-string
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=admin
# Shared token for operator kiosks and TV dashboards: open <page>?token=<value>
MM_DEVICE_TOKEN=kiosk-demo-token

MM_LOG_LEVEL=INFO
